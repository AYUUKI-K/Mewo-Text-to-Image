{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miao-image-queue",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{"name": "MIAO_KEY_QUEUE", "class_name": "MiaoKeyQueue"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MiaoKeyQueue"]}]
}
